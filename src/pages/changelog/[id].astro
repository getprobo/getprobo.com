---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Prose from "../../components/Prose.astro";
import { getCanonicalUrl } from "../../lib/i18n.ts";
import { mediaAlt, tagClass, toIsoDate } from "../../lib/changelog.ts";

export async function getStaticPaths() {
  const entries = await getCollection("changelog");
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const mediaUrls =
  entry.data.images ?? (entry.data.image ? [entry.data.image] : []);
const isLogoLayout = entry.data.imagesLayout === "logos";
const isVideoMedia = (url: string) => /\.(mp4|webm)$/i.test(url);
const dateFormatter = Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const changelogImage = mediaUrls.find((url) => !isVideoMedia(url));
const published = entry.data.date.toISOString();
const mediaKind = isLogoLayout ? "logos" : "stacked";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  image: changelogImage
    ? `https://www.probo.com${changelogImage}`
    : "https://www.probo.com/og.png",
  datePublished: published,
  dateModified: published,
  articleSection: entry.data.tags[0] ?? "Changelog",
  keywords: entry.data.tags.join(", "),
  author: {
    "@type": "Organization",
    name: "Probo",
  },
  publisher: {
    "@type": "Organization",
    name: "Probo",
    logo: {
      "@type": "ImageObject",
      url: "https://www.probo.com/probo-logo.svg",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": getCanonicalUrl(Astro.url),
  },
};

const site = Astro.site ?? new URL("https://www.probo.com");
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Changelog",
      item: new URL("/changelog", site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: entry.data.title,
    },
  ],
};
---

<Layout
  title={`${entry.data.title} — Changelog`}
  description={entry.data.description}
  ogImage={changelogImage}
  ogType="article"
>
  <meta slot="head" property="article:published_time" content={published} />
  <meta slot="head" property="article:modified_time" content={published} />
  <meta
    slot="head"
    property="article:author"
    content="https://www.probo.com/about"
  />
  <meta slot="head" property="article:section" content="Changelog" />
  {
    entry.data.tags.map((tag) => (
      <meta slot="head" property="article:tag" content={tag} />
    ))
  }
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <main class="container my-10 max-w-[720px] sm:my-20">
    <header class="animate-slide-in mb-10">
      <div
        class="mb-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2"
      >
        <a
          href="/changelog"
          class="text-muted-foreground hover:text-foreground text-sm transition-colors"
        >
          ← Changelog
        </a>
        <div
          class="text-muted-foreground flex flex-wrap items-center gap-x-2.5 gap-y-2 text-sm"
        >
          <time datetime={toIsoDate(entry.data.date)}>
            {dateFormatter.format(new Date(entry.data.date))}
          </time>
          {
            entry.data.tags.length > 0 && (
              <span class="flex flex-wrap gap-1.5">
                {entry.data.tags.map((tag) => (
                  <span class={tagClass(tag)}>{tag}</span>
                ))}
              </span>
            )
          }
        </div>
      </div>
      <h1 class="text-h3 sm:text-h2 mb-4 font-medium">
        {entry.data.title}
      </h1>
      <p class="text-muted-foreground text-lg">
        {entry.data.description}
      </p>
    </header>

    {
      mediaUrls.length > 0 &&
        (isLogoLayout ? (
          <div class="animate-slide-in animation-delay-200 mb-10 flex flex-wrap items-center gap-6">
            {mediaUrls.map((url, index) => (
              <img
                src={url}
                alt={mediaAlt(entry.data.title, {
                  layout: "logos",
                  index,
                  total: mediaUrls.length,
                })}
                class="h-12 w-auto"
              />
            ))}
          </div>
        ) : (
          <div class="mb-10 flex flex-col gap-6">
            {mediaUrls.map((url, index) => {
              const alt = mediaAlt(entry.data.title, {
                layout: mediaKind,
                index,
                total: mediaUrls.length,
                isVideo: isVideoMedia(url),
              });
              return isVideoMedia(url) ? (
                <video
                  src={url}
                  controls
                  playsinline
                  preload="none"
                  title={alt}
                  aria-label={alt}
                  class="shadow-image animate-slide-in animation-delay-200 w-full rounded-lg"
                />
              ) : (
                <img
                  src={url}
                  alt={alt}
                  class="shadow-image animate-slide-in animation-delay-200 mx-auto max-h-[600px] w-auto max-w-full rounded-lg object-contain"
                />
              );
            })}
          </div>
        ))
    }

    <Prose class="animate-slide-in animation-delay-200">
      <Content />
    </Prose>
  </main>
</Layout>
