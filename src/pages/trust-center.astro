---
import "@phosphor-icons/web/regular";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import LottiePlayer from "../components/LottiePlayer.svelte";
import LogosScroll from "../components/LogosScroll.svelte";
import FabienDevos from "../assets/testimonial/fabien-devos.jpg";
import VybeFounders from "../assets/stories/vybe-founder.png";

const overviewFeatures = [
  {
    icon: "ph-file-c",
    title: "Compliance docs, with granular permissions",
    description:
      "Share key security materials from one Trust Center, and decide what stays public, restricted, or approval-only.",
  },
  {
    icon: "ph-slack-logo",
    title: "Manage access from your stack",
    description:
      "Review access requests in Slack and keep rules aligned with the way your team already works.",
  },
  {
    icon: "ph-signature",
    title: "Your documents under an NDA",
    description:
      "Let prospects sign an NDA in the Trust Center before downloading protected, watermarked files.",
  },
  {
    icon: "ph-key",
    title: "Simple authentication",
    description:
      "Let prospects sign in with SSO or magic links without creating another account.",
  },
  {
    icon: "ph-bell-simple",
    title: "Keep customers informed",
    description:
      "Choose which policy, subprocessor, report, or audit updates subscribers should receive.",
  },
];

const accessFeatures = [
  {
    title: "Approve requests from Slack",
    lottie: "/lottie/trust-center/slack.json",
    bullets: [
      "Review access requests directly from Slack.",
      "Notify the right owners when a prospect needs access.",
      "Keep every decision synced with your Trust Center automatically.",
    ],
  },
  {
    title: "Gate sensitive downloads with an NDA",
    lottie: "/lottie/trust-center/nda.json",
    reverse: true,
    bullets: [
      "Require an NDA before sensitive files can be opened.",
      "Let prospects sign directly inside the product page.",
      "Share watermarked documents without extra legal back and forth.",
    ],
  },
  {
    title: "Frictionless authentication",
    lottie: "/lottie/trust-center/authentication.json",
    bullets: [
      "Let visitors sign in with magic links or SSO.",
      "Remove account creation from the security review flow.",
      "Keep access secure while making the buyer experience seamless.",
    ],
  },
  {
    title: "Notify subscribers about the right updates",
    lottie: "/lottie/trust-center/updates.json",
    reverse: true,
    bullets: [
      "Notify subscribers when selected security documents change.",
      "Choose which updates subscribers receive.",
      "Keep every notification relevant and controlled.",
    ],
  },
];

const publishCards = [
  {
    visual: "policies",
    title: "Policies",
    description:
      "Publish privacy, security, and compliance policies with the right visibility for each audience.",
  },
  {
    visual: "controls",
    title: "Controls",
    description:
      "Show the controls behind your compliance posture without exposing internal implementation details.",
  },
  {
    visual: "reports",
    title: "Reports",
    description:
      "Share SOC 2, ISO, pentest, and other sensitive reports behind request, NDA, or company-level approval.",
  },
  {
    visual: "audits",
    title: "Audits",
    description:
      "Give buyers access to audit evidence and supporting documents without sending files manually.",
  },
  {
    visual: "subprocessors",
    title: "Subprocessors",
    description:
      "List vendors and subprocessors with the right context, and keep subscribers informed when they change.",
  },
];

const trustedLogos = [
  {
    src: "/clients/trace_for_good.svg",
    alt: "Trace for Good",
    class: "trusted-logo--trace",
  },
  { src: "/clients/jimo.svg", alt: "Jimo", class: "trusted-logo--jimo" },
  { src: "/clients/lucis.svg", alt: "Lucis", class: "trusted-logo--lucis" },
  { src: "/clients/filz.svg", alt: "Filiz", class: "trusted-logo--filiz" },
  { src: "/clients/ahrefs.svg", alt: "Ahrefs", class: "trusted-logo--ahrefs" },
];

const faqs = [
  {
    question: "Can we make some documents public and others restricted?",
    answer:
      "Yes. Keep general resources open, gate sensitive files, and decide what stays restricted or approval-only.",
    open: true,
  },
  {
    question: "Can access require an NDA?",
    answer:
      "Yes. Prospects can sign an NDA before opening protected files, so access stays controlled without slowing the review.",
  },
  {
    question: "Can requests be approved from Slack?",
    answer:
      "Yes. The right owner can review the request in Slack, approve access, and keep the decision synced with the Trust Center.",
  },
  {
    question: "Can buyers access without creating an account?",
    answer:
      "Yes. Buyers can use magic links or SSO, so the review stays secure without adding account creation friction.",
  },
  {
    question: "Who keeps the content up to date?",
    answer:
      "Probo helps structure and maintain the materials, while your team keeps control over what is public, restricted, or approval-only.",
  },
];
---

<Layout
  title="Trust Center"
  description="Give prospects one clear place to request access, sign the right NDA, and download watermarked compliance documents while your team keeps control."
>
  <main class="-mt-16 overflow-hidden pt-16">
    <div class="relative isolate overflow-hidden">
      <div
        aria-hidden="true"
        data-node-id="241:851"
        class="pointer-events-none absolute top-[-1314px] left-1/2 z-0 size-[2265px] -translate-x-1/2 rounded-full border-[256px] border-[#E6FF03] blur-[84px]"
      >
      </div>

      <section class="relative z-10 container py-16 text-center sm:py-24">
        <div
          class="border-border-low text-tertiary-foreground mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium"
        >
          Trust Center
        </div>
        <h1
          class="mx-auto mb-6 max-w-[600px] text-[2.75rem] leading-none font-semibold tracking-[-1.4px] text-balance sm:text-5xl sm:tracking-[-1.6px]"
        >
          Your compliance documentation with access control.
        </h1>
        <p class="text-muted-foreground mx-auto mb-8 max-w-[420px] text-base">
          Give prospects one clear place to request access, sign the right NDA,
          and download watermarked documents while your team keeps control.
        </p>
        <Button href="/contact" size="lg" class="mx-auto">Book a demo</Button>
      </section>

      <section class="relative z-10 container pb-0">
        <img
          src="/trust-center/browser.svg"
          alt="Acme Trust Center browser preview"
          width="1146"
          height="786"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="mx-auto h-auto w-full"
        />
      </section>
    </div>

    <section class="container pt-16 pb-0 text-center sm:pt-32">
      <h2
        class="mx-auto max-w-[552px] text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-balance text-[#141e12]"
      >
        Everything your buyers need to review security, in one place.
      </h2>
      <p
        class="mx-auto mt-2 max-w-[504px] text-[16px] leading-6 text-[#6b716a]"
      >
        Help buyers find the right materials faster, while your team decides
        what is public, restricted, or approval-only.
      </p>

      <div class="overview-feature-grid mt-16">
        {
          overviewFeatures.map((feature) => (
            <div class="overview-feature">
              <i class:list={["ph overview-feature-icon", feature.icon]} />
              <div class="overview-feature-copy">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="access-control" class="pt-16 pb-0 sm:pt-32">
      <div class="container mb-12 text-center sm:mb-16">
        <h2
          class="mx-auto max-w-[600px] text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-balance"
        >
          Give buyers access without losing control
        </h2>
        <p
          class="text-muted-foreground mx-auto mt-2 max-w-[520px] text-[16px] leading-6"
        >
          Approve requests in Slack, support SSO or magic links, and keep every
          permission attached to the right company.
        </p>
      </div>

      <div class="space-y-8 sm:space-y-12">
        {
          accessFeatures.map((feature) => (
            <div
              class:list={[
                "container flex flex-col gap-8 lg:items-center lg:gap-16",
                feature.reverse ? "lg:flex-row-reverse" : "lg:flex-row",
              ]}
            >
              <div class="bg-subtle relative aspect-[508/664] w-full overflow-hidden rounded-2xl lg:w-[508px] lg:flex-none">
                <LottiePlayer
                  client:visible
                  src={feature.lottie}
                  label={`${feature.title} animation`}
                  class="size-full origin-center scale-[1.12] transform-gpu"
                />
              </div>

              <div
                class:list={[
                  "w-full max-w-[508px] lg:w-[508px] lg:flex-none",
                  feature.reverse ? "lg:pr-16" : "lg:pl-16",
                ]}
              >
                <h3
                  class:list={[
                    "mb-6 font-semibold",
                    feature.reverse
                      ? "text-[20px] leading-7 tracking-[-0.4px]"
                      : "text-[24px] leading-8 tracking-[-0.6px]",
                  ]}
                >
                  {feature.title}
                </h3>
                <ul class="text-muted-foreground space-y-3 text-[16px] leading-6">
                  {feature.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <i class="ph ph-check inline-flex size-6 shrink-0 items-center justify-center text-[24px] leading-none text-current" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="container pt-16 pb-0 sm:pt-32">
      <div class="mb-16 text-center">
        <h2
          class="mx-auto max-w-[560px] text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-balance"
        >
          Publish every security resource buyers ask for
        </h2>
        <p
          class="text-muted-foreground mx-auto mt-2 max-w-[520px] text-[16px] leading-6"
        >
          Keep the review moving without turning your team into a document
          forwarding queue.
        </p>
      </div>

      <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          publishCards.map((card) => (
            <article class="flex flex-col gap-6">
              <div
                class:list={[
                  "trust-category-visual",
                  `trust-category-visual--${card.visual}`,
                ]}
                aria-hidden="true"
              />
              <div class="flex flex-col gap-2">
                <h3 class="text-[20px] leading-7 font-semibold tracking-[-0.4px]">
                  {card.title}
                </h3>
                <p class="text-muted-foreground text-[16px] leading-6">
                  {card.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="container pt-16 pb-0 sm:pt-32">
      <div class="pb-12 text-center sm:pb-16">
        <h2
          class="text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-[#141e12]"
        >
          Trusted by 130+ companies
        </h2>
        <p
          class="mx-auto mt-2 max-w-[504px] text-[16px] leading-6 text-[#6b716a]"
        >
          Security teams use Probo to share the right materials, protect
          sensitive documents, and keep access requests moving.
        </p>
      </div>

      <div class="trusted-showcase">
        <div class="trusted-photo-card">
          <Image
            src={VybeFounders}
            alt="Fabien Devos and the Vybe founding team"
            width={528}
            height={528}
            densities={[1, 2]}
            class="trusted-photo"
            loading="lazy"
          />
        </div>

        <div class="trusted-quote-card">
          <div class="trusted-quote-content">
            <blockquote class="trusted-quote">
              <span>&ldquo;Probo makes security review</span>
              <span>feel simple, fast, and controlled.&rdquo;</span>
            </blockquote>

            <div class="trusted-author">
              <div class="trusted-author-copy">
                <div class="trusted-author-name">Fabien Devos</div>
                <div class="trusted-author-role">
                  Co-founder &amp; CTO at Vybe
                </div>
              </div>
              <Image
                src={FabienDevos}
                alt="Fabien Devos"
                width={48}
                height={48}
                densities={[1, 2]}
                class="trusted-avatar"
                loading="lazy"
              />
            </div>
          </div>

          <div class="trusted-logo-block">
            <p>Trusted by teams building compliance-ready workflows</p>
            <div class="trusted-logo-rail" aria-label="Trusted companies">
              <LogosScroll class="trusted-logo-ticker" client:load>
                {
                  trustedLogos.map((logo) => (
                    <span class:list={["trusted-logo-item", logo.class]}>
                      <img src={logo.src} alt={logo.alt} loading="lazy" />
                    </span>
                  ))
                }
              </LogosScroll>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container pt-16 pb-16 sm:pt-32 sm:pb-24">
      <h2
        class="mb-6 text-center text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-[#141e12]"
      >
        Frequently asked questions
      </h2>
      <div class="mx-auto max-w-[768px]">
        {
          faqs.map((faq) => (
            <details
              class="group border-border-low border-b py-4 last:border-b-0"
              open={faq.open}
            >
              <summary class="flex list-none items-center gap-6 text-[16px] leading-6 font-medium text-[#141e12] [&::-webkit-details-marker]:hidden">
                <span class="flex-1">{faq.question}</span>
                <i class="ph ph-plus flex size-4 shrink-0 items-center justify-center text-[16px] leading-none group-open:hidden" />
                <i class="ph ph-minus hidden size-4 shrink-0 items-center justify-center text-[16px] leading-none group-open:flex" />
              </summary>
              <p class="mt-2 w-full text-[16px] leading-6 text-[#6b716a]">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .overview-feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 48px;
  }

  .overview-feature {
    display: flex;
    width: min(100%, 328px);
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .overview-feature-icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    color: #343330;
    font-size: 32px;
    line-height: 1;
  }

  .overview-feature-copy {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 3px 0;
    color: #141e12;
    font-size: 16px;
    line-height: 24px;
    text-align: center;
    word-break: break-word;
  }

  .overview-feature-copy h3,
  .overview-feature-copy p {
    width: 100%;
  }

  .overview-feature-copy h3 {
    color: #141e12;
    font-weight: 500;
  }

  .overview-feature-copy p {
    color: #6b716a;
    font-weight: 400;
  }

  @media (min-width: 640px) {
    .overview-feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
      row-gap: 56px;
    }
  }

  @media (min-width: 1024px) {
    .overview-feature-grid {
      position: relative;
      display: block;
      width: 100%;
      max-width: 1080px;
      height: 346px;
      margin-right: auto;
      margin-left: auto;
    }

    .overview-feature {
      position: absolute;
      width: 328px;
    }

    .overview-feature:nth-child(1) {
      top: 0;
      left: 0;
    }

    .overview-feature:nth-child(1) .overview-feature-copy h3 {
      max-width: 276px;
      margin-right: auto;
      margin-left: auto;
    }

    .overview-feature:nth-child(2) {
      top: 0;
      left: 376px;
    }

    .overview-feature:nth-child(3) {
      top: 0;
      left: 752px;
    }

    .overview-feature:nth-child(4) {
      top: 201px;
      left: 188px;
    }

    .overview-feature:nth-child(5) {
      top: 201px;
      left: 564px;
    }
  }

  .trusted-showcase {
    display: grid;
    width: 100%;
    max-width: 1080px;
    gap: 24px;
    margin-right: auto;
    margin-left: auto;
  }

  .trusted-photo-card,
  .trusted-quote-card {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #f6f9f5;
  }

  .trusted-photo-card {
    aspect-ratio: 1 / 1;
  }

  .trusted-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trusted-quote-card {
    display: flex;
    min-height: 420px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 72px 20px 32px;
    text-align: center;
  }

  .trusted-quote-card::before {
    position: absolute;
    right: -62%;
    bottom: -74%;
    width: 192%;
    max-width: 1010px;
    aspect-ratio: 1 / 1;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      #e6ff03 0 27%,
      rgb(230 255 3 / 0.62) 43%,
      rgb(230 255 3 / 0.18) 58%,
      transparent 74%
    );
    content: "";
    pointer-events: none;
  }

  .trusted-quote-content,
  .trusted-logo-block {
    position: relative;
    z-index: 1;
  }

  .trusted-quote-content {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .trusted-quote {
    display: flex;
    width: 100%;
    flex-direction: column;
    margin: 0;
    color: #141e12;
    font-size: 26px;
    line-height: 32px;
    font-weight: 600;
    letter-spacing: -1px;
    text-align: center;
    text-wrap: balance;
    word-break: break-word;
  }

  .trusted-author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .trusted-author-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 3px 0;
    font-size: 16px;
    line-height: 24px;
  }

  .trusted-author-name {
    color: #141e12;
    font-weight: 500;
  }

  .trusted-author-role {
    color: #6b716a;
    font-weight: 400;
  }

  .trusted-avatar {
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    object-fit: cover;
  }

  .trusted-logo-block {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .trusted-logo-block p {
    color: #6b716a;
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    text-align: center;
  }

  .trusted-logo-rail {
    width: 792px;
    max-width: calc(100vw - 48px);
    height: 24px;
    overflow: hidden;
  }

  :global(.trusted-logo-ticker) {
    height: 24px;
    overflow: hidden;
  }

  :global(.trusted-logo-ticker .splide__track),
  :global(.trusted-logo-ticker .splide__list) {
    height: 24px;
  }

  :global(.trusted-logo-ticker .splide__slide) {
    display: flex;
    height: 24px;
    align-items: center;
  }

  .trusted-logo-item {
    display: flex;
    height: 24px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0 15px;
    opacity: 0.6;
  }

  .trusted-logo-item img {
    display: block;
    width: 100%;
    height: 24px;
    object-fit: contain;
  }

  .trusted-logo--trace {
    width: 190.5px;
  }

  .trusted-logo--jimo {
    width: 78px;
  }

  .trusted-logo--lucis {
    width: 109.5px;
  }

  .trusted-logo--filiz {
    width: 115.5px;
  }

  .trusted-logo--ahrefs {
    width: 123px;
  }

  @media (min-width: 1024px) {
    .trusted-showcase {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .trusted-quote-card {
      min-height: auto;
      aspect-ratio: 1 / 1;
      padding: 96px 32px 32px;
    }

    .trusted-quote {
      font-size: 30px;
      line-height: 36px;
    }
  }

  .trust-category-visual {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f6f9f5;
  }

  .trust-category-visual--policies {
    background:
      radial-gradient(
        circle at -24% -8%,
        #e6ff03 0 42%,
        rgb(230 255 3 / 0.28) 57%,
        transparent 72%
      ),
      radial-gradient(
        circle at -20% 108%,
        #e6ff03 0 34%,
        rgb(230 255 3 / 0.18) 54%,
        transparent 72%
      ),
      #f6f9f5;
  }

  .trust-category-visual--controls {
    background:
      radial-gradient(
        circle at 50% 50%,
        #e6ff03 0 16%,
        rgb(230 255 3 / 0.42) 31%,
        rgb(246 249 245 / 0.76) 53%,
        transparent 70%
      ),
      #f6f9f5;
  }

  .trust-category-visual--reports {
    background:
      radial-gradient(
        circle at 50% -28%,
        #e6ff03 0 40%,
        rgb(230 255 3 / 0.28) 57%,
        transparent 72%
      ),
      radial-gradient(
        circle at 50% 128%,
        #e6ff03 0 40%,
        rgb(230 255 3 / 0.28) 57%,
        transparent 72%
      ),
      #f6f9f5;
  }

  .trust-category-visual--audits {
    background:
      radial-gradient(
        circle at 0% 0%,
        #e6ff03 0 43%,
        rgb(230 255 3 / 0.24) 60%,
        transparent 78%
      ),
      #f6f9f5;
  }

  .trust-category-visual--subprocessors {
    background:
      radial-gradient(
        circle at 50% 112%,
        #e6ff03 0 45%,
        rgb(230 255 3 / 0.24) 62%,
        transparent 79%
      ),
      #f6f9f5;
  }
</style>
