    <section class="container pt-16 pb-16 sm:pt-32 sm:pb-24">
      <h2
        class="mb-6 text-center text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-[#141e12]"
      >
        Frequently asked questions
      </h2>
      <div class="faq-accordion mx-auto max-w-[768px]" data-faq-accordion>
        {
          faqs.map((faq, index) => (
            <div class="faq-item" data-faq-item>
              <h3>
                <button
                  class="faq-trigger"
                  type="button"
                  id={`trust-center-faq-trigger-${index}`}
                  aria-expanded="false"
                  aria-controls={`trust-center-faq-panel-${index}`}
                  data-faq-trigger
                >
                  <span>{faq.question}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <i class="ph ph-plus faq-icon-plus" />
                    <i class="ph ph-minus faq-icon-minus" />
                  </span>
                </button>
              </h3>
              <div
                class="faq-panel"
                id={`trust-center-faq-panel-${index}`}
                role="region"
                aria-labelledby={`trust-center-faq-trigger-${index}`}
                aria-hidden="true"
                data-faq-panel
              >
                <div class="faq-panel-inner">
                  <p>{faq.answer}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<script>
  const initTrustCenterAnimations = () => {
    const documentVisuals = Array.from(
      document.querySelectorAll<HTMLElement>("[data-documents-visual]"),
    );

    if (documentVisuals.length === 0) {
      return;
    }

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      documentVisuals.forEach((visual) => {
        visual.classList.add("is-visible");
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );

    documentVisuals.forEach((visual) => {
      if (visual.dataset.motionReady === "true") {
        return;
      }

      visual.dataset.motionReady = "true";
      visual.classList.add("is-awaiting-animation");
      observer.observe(visual);
    });
  };

  const initTrustCenterFaq = () => {
    const faqAccordions = Array.from(
      document.querySelectorAll<HTMLElement>("[data-faq-accordion]"),
    );

    faqAccordions.forEach((faqAccordion) => {
      if (faqAccordion.dataset.faqReady === "true") {
        return;
      }

      faqAccordion.dataset.faqReady = "true";

      const faqItems = Array.from(
        faqAccordion.querySelectorAll<HTMLElement>("[data-faq-item]"),
      );

      const setFaqItemState = (item: HTMLElement, shouldOpen: boolean) => {
        const trigger =
          item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
        const panel = item.querySelector<HTMLElement>("[data-faq-panel]");

        if (!trigger || !panel) {
          return;
        }

        item.classList.toggle("is-open", shouldOpen);
        trigger.setAttribute("aria-expanded", String(shouldOpen));
        panel.setAttribute("aria-hidden", String(!shouldOpen));
      };

      faqItems.forEach((item, index) => {
        const trigger =
          item.querySelector<HTMLButtonElement>("[data-faq-trigger]");

        if (!trigger) {
          return;
        }

        trigger.addEventListener("click", () => {
          const shouldOpen = !item.classList.contains("is-open");

          faqItems.forEach((faqItem) => {
            setFaqItemState(faqItem, faqItem === item && shouldOpen);
          });
        });

        trigger.addEventListener("keydown", (event) => {
          const lastIndex = faqItems.length - 1;
          const nextIndex =
            event.key === "ArrowDown"
              ? Math.min(index + 1, lastIndex)
              : event.key === "ArrowUp"
                ? Math.max(index - 1, 0)
                : event.key === "Home"
                  ? 0
                  : event.key === "End"
                    ? lastIndex
                    : index;

          if (nextIndex === index) {
            return;
          }

          event.preventDefault();
          faqItems[nextIndex]
            ?.querySelector<HTMLButtonElement>("[data-faq-trigger]")
            ?.focus();
        });
      });
    });
  };

  const initTrustCenterPage = () => {
    initTrustCenterAnimations();
    initTrustCenterFaq();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTrustCenterPage, {
      once: true,
    });
  } else {
    initTrustCenterPage();
  }
</script>

<style>
  .overview-feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 48px;
  }

  .overview-feature {
    display: flex;
    width: min(100%, 328px);
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .overview-feature-icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    color: #343330;
    font-size: 32px;
    line-height: 1;
  }

  .overview-feature-copy {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 3px 0;
    color: #141e12;
    font-size: 16px;
    line-height: 24px;
    text-align: center;
    word-break: break-word;
  }

  .overview-feature-copy h3,
  .overview-feature-copy p {
    width: 100%;
  }

  .overview-feature-copy h3 {
    color: #141e12;
    font-weight: 500;
  }

  .overview-feature-copy p {
    color: #6b716a;
    font-weight: 400;
  }

  @media (min-width: 640px) {
    .overview-feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
      row-gap: 56px;
    }
  }

  @media (min-width: 1024px) {
    .overview-feature-grid {
      position: relative;
      display: block;
      width: 100%;
      max-width: 1080px;
      height: 346px;
      margin-right: auto;
      margin-left: auto;
    }

    .overview-feature {
      position: absolute;
      width: 328px;
    }

    .overview-feature:nth-child(1) {
      top: 0;
      left: 0;
    }

    .overview-feature:nth-child(1) .overview-feature-copy h3 {
      max-width: 276px;
      margin-right: auto;
      margin-left: auto;
    }

