---
import { Image } from "astro:assets";
import { dynamicImages } from "../lib/images.ts";
import FrameworkBadge from "./FrameworkBadge.svelte";
import { frameworks } from "../content/frameworks.ts";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"wall">;
}

const { post } = Astro.props;
const d = post.data;

const images = dynamicImages(
  import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/wall/*.{jpeg,jpg,png,gif,svg,webp}",
  ),
);

const framework = frameworks.find((f) => f.label === d.framework);
const followers =
  d.followers != null ? d.followers.toLocaleString("en-US") : null;

// Escaped strings for the interactive language toggle (client script reads these).
const escapeAttr = (s: string) =>
  s
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
---

<article
  class:list={[
    "bg-secondary border-border-solid mb-5 inline-block w-full break-inside-avoid overflow-hidden rounded-xl border shadow-sm transition-shadow duration-300 hover:shadow-md",
    d.postUrl && "relative cursor-pointer",
  ]}
>
  {
    d.postUrl && (
      <a
        href={d.postUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute inset-0 z-[1]"
        aria-label={`View ${d.company} post on LinkedIn`}
      />
    )
  }
  <div class="p-4 pb-2">
    <div class="flex items-start gap-3">
      <div class="relative flex-shrink-0">
        <Image
          src={images(d.logo)}
          alt={`${d.company} logo`}
          width={48}
          height={48}
          densities={[1, 2]}
          class="border-border-solid size-12 rounded-lg border object-cover"
        />
        {
          d.avatar && (
            <span class="bg-secondary absolute -right-2 -bottom-2 size-5 overflow-hidden rounded-full shadow-sm ring-2 ring-white">
              <Image
                src={images(d.avatar)}
                alt={d.author ?? d.company}
                width={20}
                height={20}
                densities={[1, 2]}
                class="size-full object-cover"
              />
            </span>
          )
        }
      </div>

      <div class="min-w-0 flex-1">
        <h3 class="text-primary text-sm leading-tight font-semibold">
          {d.company}
        </h3>
        {
          followers && (
            <p class="text-muted-foreground text-xxs mt-0.5">
              {followers} followers
            </p>
          )
        }
        {
          d.author && (
            <p class="text-tertiary-foreground text-xxs mt-0.5">{d.author}</p>
          )
        }
      </div>

      <div class="relative z-[2] flex flex-shrink-0 items-center gap-2">
        {
          d.originalLang && d.translatedPost && (
            <button
              type="button"
              data-wall-lang
              data-original={escapeAttr(d.post)}
              data-translated={escapeAttr(d.translatedPost)}
              data-lang-label={d.originalLang}
              class="border-border-solid text-muted-foreground hover:border-quaternary hover:text-primary rounded border px-1.5 py-0.5 text-[10px] transition-colors"
              title={`Show original (${d.originalLang})`}
            >
              {d.originalLang}
            </button>
          )
        }
        <svg
          class="h-5 w-5 text-[#0a66c2]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-label="Posted on LinkedIn"
          role="img"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
          ></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="px-4 pb-3">
    <div
      data-wall-post
      class="text-primary text-sm leading-[1.4285] tracking-normal whitespace-pre-line"
    >
      {d.translatedPost ?? d.post}
    </div>
  </div>

  {
    d.thumbnail && (
      <div class="border-border-solid border-t">
        <Image
          src={images(d.thumbnail)}
          alt={`Post by ${d.company}`}
          width={800}
          class="block h-auto w-full object-cover"
        />
      </div>
    )
  }

  <div
    class="border-border-solid text-muted-foreground text-xxs flex items-center justify-between gap-3 border-t px-4 py-2.5"
  >
    <div class="flex items-center gap-2">
      {
        (d.likes != null || d.comments != null) && (
          <span class="flex -space-x-1" aria-hidden="true">
            <span class="grid size-4 place-items-center rounded-full bg-[#0a66c2] text-[9px]">
              👍
            </span>
            <span class="grid size-4 place-items-center rounded-full bg-[#e0245e] text-[9px]">
              ❤️
            </span>
            <span class="bg-accent grid size-4 place-items-center rounded-full text-[9px]">
              🎉
            </span>
          </span>
        )
      }
      {d.likes != null && <span>{d.likes.toLocaleString("en-US")}</span>}
      {
        d.comments != null && (
          <span>
            · {d.comments} comment{d.comments === 1 ? "" : "s"}
          </span>
        )
      }
    </div>

    {
      framework && (
        <FrameworkBadge name={framework.badge} class="block size-7" />
      )
    }
  </div>
</article>
