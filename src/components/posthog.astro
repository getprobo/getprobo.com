<script>
  import {
    configurePosthogFromBanner,
    captureToolbarPayloadFromHash,
    loadToolbarFromCache,
  } from "../lib/posthog";

  // Grab the toolbar payload from the URL hash before any client-side nav drops it.
  captureToolbarPayloadFromHash();

  document.addEventListener(
    "probo-ready",
    (e) => configurePosthogFromBanner((e as CustomEvent).detail.config),
    { once: true },
  );

  // Re-inject the toolbar after each Astro view-transition body swap.
  document.addEventListener("astro:after-swap", loadToolbarFromCache);
</script>
