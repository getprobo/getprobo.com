---
import { Image } from "astro:assets";
import AhrefsStory from "../assets/stories/ahrefs.jpg";
import type { MenuGroup } from "../content/menu";
import Button from "./ui/Button.svelte";

interface Props {
  groups: MenuGroup[];
}

const { groups } = Astro.props;
const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
const menuId = "desktop-navigation-menu";
---

<header-menu class="relative flex h-8 items-center gap-[9px]">
  {
    groups.map((group, index) => {
      const triggerId = `${menuId}-trigger-${index}`;
      const isActive = group.items.some(({ href }) => isCurrent(href));

      return (
        <Button
          variant="navigation"
          size="navigation"
          type="button"
          id={triggerId}
          data-menu-trigger
          data-menu-index={index}
          aria-expanded="false"
          aria-controls={menuId}
          aria-current={isActive ? "page" : undefined}
        >
          {group.label}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M4 5.5L7 8.5L10 5.5"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </Button>
      );
    })
  }

  <div
    data-hover-corridor
    class="fixed top-12 left-1/2 z-10 h-7 w-[min(896px,calc(100vw-40px))] -translate-x-1/2"
    hidden
  >
  </div>

  <div
    id={menuId}
    data-menu-viewport
    class="fixed top-16 left-1/2 z-10 w-[min(896px,calc(100vw-40px))] pt-3"
    hidden
  >
    <div
      data-menu-shell
      class="bg-secondary relative h-[444px] overflow-hidden rounded-2xl border shadow-[0_16px_32px_rgba(186,193,122,0.2)]"
    >
      {
        groups.map((group, index) => (
          <div
            data-menu-panel
            data-menu-index={index}
            role="group"
            aria-labelledby={`${menuId}-trigger-${index}`}
            class="absolute inset-0 grid grid-cols-2 gap-8 p-3"
            hidden
          >
            <div class="flex min-w-0 flex-col gap-6 px-4 py-6">
              <p class="text-muted-foreground px-2 text-sm font-medium">
                {group.label}
              </p>
              <div class="flex flex-col gap-2">
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      "hover:bg-subtle focus-visible:bg-subtle flex min-w-0 items-center gap-4 rounded-2xl p-2 outline-none",
                      { "bg-subtle": isCurrent(item.href) },
                    ]}
                  >
                    <span class="grid size-[52px] shrink-0 place-items-center rounded-[10px] border">
                      <i
                        class={`ph ph-${item.icon} text-[32px] leading-none`}
                        aria-hidden="true"
                      />
                    </span>
                    <span class="min-w-0 text-base leading-6">
                      <span class="block truncate font-semibold">
                        {item.label}
                      </span>
                      <span class="text-muted-foreground block truncate">
                        {item.description}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>

            <a
              href={group.feature.href}
              class="bg-subtle group/feature relative block min-w-0 overflow-hidden rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-current"
              aria-label={`${group.feature.eyebrow}: ${group.feature.title}`}
            >
              {group.feature.variant === "story" && (
                <>
                  <Image
                    src={AhrefsStory}
                    alt="Ahrefs team collaborating in their office"
                    class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover/feature:scale-[1.02]"
                    widths={[420, 840]}
                    sizes="420px"
                  />
                  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/5 to-black/35" />
                </>
              )}

              {group.feature.variant === "product" && (
                <img
                  src="/trust-center/browser.svg"
                  alt="Compliance Portal preview"
                  class="absolute top-[100px] left-6 h-[720px] w-[1080px] max-w-none rounded-[15px] object-cover object-left-top shadow-[0_16px_32px_rgba(186,193,122,0.2)] transition-transform duration-500 group-hover/feature:-translate-y-1"
                />
              )}

              {group.feature.variant === "guide" && (
                <>
                  <div class="absolute top-[100px] left-[-174px] flex gap-[13px]">
                    {[
                      ["ISO27001", "ISO 27001"],
                      ["SOC2_TYPE2", "SOC 2 Type II"],
                      ["HIPAA", "HIPAA"],
                    ].map(([icon, title]) => (
                      <div class="h-[220px] w-[247px] shrink-0 overflow-hidden rounded-[19px] border bg-white">
                        <div class="relative grid h-[151px] place-items-center border-b bg-[radial-gradient(circle,#d8dcd8_1px,transparent_1px)] [background-size:10px_10px]">
                          <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#e6ff03]/25 to-transparent" />
                          <img
                            src={`/frameworks/${icon}.svg`}
                            alt=""
                            class="relative size-[101px]"
                          />
                        </div>
                        <p class="py-[18px] text-center text-[22px] leading-8 font-medium">
                          {title}
                        </p>
                      </div>
                    ))}
                  </div>
                  <div class="absolute inset-x-[-100px] bottom-[-110px] h-56 rounded-full bg-[#e6ff03] blur-[55px]" />
                </>
              )}

              <span
                class:list={[
                  "absolute top-6 right-6 left-6 z-10 flex flex-col items-start",
                  { "text-white": group.feature.variant === "story" },
                ]}
              >
                <span
                  class:list={[
                    "text-sm leading-5 font-medium",
                    group.feature.variant === "story"
                      ? "text-[#e6ff03]"
                      : "text-muted-foreground",
                  ]}
                >
                  {group.feature.eyebrow}
                </span>
                <span class="text-[20px] leading-7 font-semibold tracking-[-0.4px]">
                  {group.feature.title}
                </span>
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</header-menu>

<script>
  import { customElementDefine } from "../lib/dom";

  const closeDelay = 160;
  const shellDuration = 180;
  const contentExitDuration = 90;
  const contentEnterDuration = 180;
  const contentSwitchOpacity = 0.18;
  const contentTravelDistance = 12;
  const easing = "cubic-bezier(0.22, 1, 0.36, 1)";

  class HeaderMenu extends HTMLElement {
    triggers: HTMLButtonElement[] = [];
    panels: HTMLElement[] = [];
    viewport: HTMLElement | null = null;
    corridor: HTMLElement | null = null;
    activeIndex = -1;
    closeTimer: number | null = null;
    hideTimer: number | null = null;
    transitionToken = 0;
    lastPointerType = "";
    suppressNextFocus = false;

    connectedCallback() {
      this.triggers = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]"),
      );
      this.panels = Array.from(
        this.querySelectorAll<HTMLElement>("[data-menu-panel]"),
      );
      this.viewport = this.querySelector("[data-menu-viewport]");
      this.corridor = this.querySelector("[data-hover-corridor]");

      this.triggers.forEach((trigger) => {
        trigger.addEventListener("pointerenter", this.onTriggerPointerEnter);
        trigger.addEventListener("pointerdown", this.onTriggerPointerDown);
        trigger.addEventListener("focus", this.onTriggerFocus);
        trigger.addEventListener("click", this.onTriggerClick);
      });
      this.addEventListener("pointerenter", this.cancelClose);
      this.addEventListener("pointerleave", this.scheduleClose);
      this.addEventListener("focusout", this.onFocusOut);
      document.addEventListener("pointerdown", this.onDocumentPointerDown);
      document.addEventListener("keydown", this.onKeyDown);
    }

    disconnectedCallback() {
      this.triggers.forEach((trigger) => {
        trigger.removeEventListener("pointerenter", this.onTriggerPointerEnter);
        trigger.removeEventListener("pointerdown", this.onTriggerPointerDown);
        trigger.removeEventListener("focus", this.onTriggerFocus);
        trigger.removeEventListener("click", this.onTriggerClick);
      });
      this.removeEventListener("pointerenter", this.cancelClose);
      this.removeEventListener("pointerleave", this.scheduleClose);
      this.removeEventListener("focusout", this.onFocusOut);
      document.removeEventListener("pointerdown", this.onDocumentPointerDown);
      document.removeEventListener("keydown", this.onKeyDown);
      this.cancelClose();
      if (this.hideTimer !== null) window.clearTimeout(this.hideTimer);
    }

    indexFromTrigger = (trigger: HTMLButtonElement) =>
      Number(trigger.dataset.menuIndex);

    onTriggerPointerEnter = (event: PointerEvent) => {
      if (event.pointerType === "touch") return;
      this.open(
        this.indexFromTrigger(event.currentTarget as HTMLButtonElement),
      );
    };

    onTriggerPointerDown = (event: PointerEvent) => {
      this.lastPointerType = event.pointerType;
    };

    onTriggerFocus = (event: FocusEvent) => {
      if (this.suppressNextFocus) {
        this.suppressNextFocus = false;
        return;
      }
      if (this.lastPointerType === "touch") return;
      this.open(
        this.indexFromTrigger(event.currentTarget as HTMLButtonElement),
      );
    };

    onTriggerClick = (event: MouseEvent) => {
      const index = this.indexFromTrigger(
        event.currentTarget as HTMLButtonElement,
      );
      if (
        this.lastPointerType === "touch" &&
        event.detail > 0 &&
        this.activeIndex === index
      ) {
        this.close();
        return;
      }
      this.open(index);
    };

    onFocusOut = (event: FocusEvent) => {
      if (!this.contains(event.relatedTarget as Node | null)) {
        this.scheduleClose();
      }
    };

    onDocumentPointerDown = (event: PointerEvent) => {
      if (!this.contains(event.target as Node)) this.close();
    };

    onKeyDown = (event: KeyboardEvent) => {
      if (event.key !== "Escape") {
        this.lastPointerType = "";
        return;
      }
      if (this.activeIndex === -1) return;
      event.preventDefault();
      const trigger = this.triggers[this.activeIndex];
      this.close();
      this.suppressNextFocus = true;
      trigger?.focus();
    };

    cancelClose = () => {
      if (this.closeTimer === null) return;
      window.clearTimeout(this.closeTimer);
      this.closeTimer = null;
    };

    scheduleClose = () => {
      this.cancelClose();
      this.closeTimer = window.setTimeout(() => {
        this.closeTimer = null;
        if (!this.matches(":hover") && !this.matches(":focus-within")) {
          this.close();
        }
      }, closeDelay);
    };

    open = (index: number) => {
      if (!this.viewport || !this.panels[index]) return;
      this.cancelClose();
      if (this.hideTimer !== null) {
        window.clearTimeout(this.hideTimer);
        this.hideTimer = null;
      }

      const previousIndex = this.activeIndex;
      if (previousIndex === index && this.dataset.open === "true") return;

      this.activeIndex = index;
      this.dataset.open = "true";
      this.viewport.hidden = false;
      if (this.corridor) this.corridor.hidden = false;
      this.triggers.forEach((trigger, triggerIndex) => {
        trigger.setAttribute(
          "aria-expanded",
          String(triggerIndex === this.activeIndex),
        );
      });

      this.transitionPanels(index);
    };

    transitionPanels = async (nextIndex: number) => {
      const nextPanel = this.panels[nextIndex];
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const token = ++this.transitionToken;
      const visiblePanel = this.panels.find((panel) => !panel.hidden);
      const visibleIndex = visiblePanel
        ? Number(visiblePanel.dataset.menuIndex)
        : -1;

      this.panels.forEach((panel) => {
        panel.getAnimations().forEach((animation) => animation.cancel());
        if (panel !== visiblePanel) panel.hidden = true;
      });

      if (!visiblePanel) {
        this.showPanel(nextPanel);
        nextPanel.animate(
          reducedMotion
            ? [{ opacity: 0 }, { opacity: 1 }]
            : [
                { opacity: 0, transform: "scale(0.985)" },
                { opacity: 1, transform: "scale(1)" },
              ],
          {
            duration: reducedMotion ? 120 : shellDuration,
            easing,
          },
        );
        return;
      }

      if (visiblePanel === nextPanel) {
        this.showPanel(nextPanel);
        return;
      }

      const direction = nextIndex > visibleIndex ? 1 : -1;
      visiblePanel.inert = true;
      visiblePanel.setAttribute("aria-hidden", "true");
      const exitAnimation = visiblePanel.animate(
        reducedMotion
          ? [{ opacity: 1 }, { opacity: contentSwitchOpacity }]
          : [
              { opacity: 1, transform: "translateX(0)" },
              {
                opacity: contentSwitchOpacity,
                transform: `translateX(${-direction * contentTravelDistance}px)`,
              },
            ],
        {
          duration: reducedMotion ? 60 : contentExitDuration,
          easing,
        },
      );

      try {
        await exitAnimation.finished;
      } catch {
        return;
      }

      if (token !== this.transitionToken || this.activeIndex !== nextIndex) {
        return;
      }

      visiblePanel.hidden = true;
      this.showPanel(nextPanel);
      const enterAnimation = nextPanel.animate(
        reducedMotion
          ? [{ opacity: contentSwitchOpacity }, { opacity: 1 }]
          : [
              {
                opacity: contentSwitchOpacity,
                transform: `translateX(${direction * contentTravelDistance}px)`,
              },
              { opacity: 1, transform: "translateX(0)" },
            ],
        {
          duration: reducedMotion ? 80 : contentEnterDuration,
          easing,
        },
      );

      try {
        await enterAnimation.finished;
      } catch {
        return;
      }

      if (token === this.transitionToken && this.activeIndex === nextIndex) {
        this.showPanel(nextPanel);
      }
    };

    showPanel = (panel: HTMLElement) => {
      panel.hidden = false;
      panel.inert = false;
      panel.removeAttribute("aria-hidden");
    };

    close = () => {
      if (this.activeIndex === -1) return;
      this.cancelClose();
      this.transitionToken += 1;
      this.panels.forEach((panel) =>
        panel.getAnimations().forEach((animation) => animation.cancel()),
      );
      this.activeIndex = -1;
      this.dataset.open = "false";
      this.triggers.forEach((trigger) =>
        trigger.setAttribute("aria-expanded", "false"),
      );

      this.hideTimer = window.setTimeout(() => {
        if (this.dataset.open === "true") return;
        if (this.viewport) this.viewport.hidden = true;
        if (this.corridor) this.corridor.hidden = true;
        this.panels.forEach((panel) => (panel.hidden = true));
        this.hideTimer = null;
      }, shellDuration);
    };
  }

  customElementDefine("header-menu", () => HeaderMenu);
</script>

<style>
  [data-menu-viewport] {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-4px) scale(0.99);
    transform-origin: top center;
    transition:
      opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  header-menu[data-open="true"] [data-menu-viewport] {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-menu-viewport] {
      transform: translateX(-50%);
      transition: opacity 120ms linear;
    }

    header-menu[data-open="true"] [data-menu-viewport] {
      transform: translateX(-50%);
    }
  }
</style>
