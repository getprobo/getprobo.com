---
import type { MenuFeature, MenuItem } from "../content/menu";

interface Props {
  label: string;
  items: MenuItem[];
  feature: MenuFeature;
}

const { label, items, feature } = Astro.props;
---

<header-menu class="relative block">
  <details class="group">
    <summary
      class="hover:text-success flex list-none items-center gap-1 px-3 py-1 text-base font-medium outline-none select-none focus-visible:ring-2 focus-visible:ring-current focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden"
    >
      {label}
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="transition-transform duration-200 group-open:rotate-180"
        aria-hidden="true"
      >
        <path
          d="M4 5.5L7 8.5L10 5.5"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </summary>

    <div
      class="fixed top-16 left-1/2 z-10 w-[min(896px,calc(100vw-40px))] -translate-x-1/2 pt-3"
    >
      <div
        class="bg-secondary grid h-[444px] grid-cols-2 gap-8 overflow-hidden rounded-2xl border p-3 shadow-[0_16px_32px_rgba(186,193,122,0.2)]"
      >
        <div class="flex min-w-0 flex-col gap-6 px-4 py-6">
          <p class="text-muted-foreground px-2 text-sm font-medium">{label}</p>
          <div class="flex flex-col gap-2">
            {
              items.map((item) => (
                <a
                  href={item.href}
                  class="hover:bg-subtle focus-visible:bg-subtle flex min-w-0 items-center gap-4 rounded-2xl p-2 outline-none"
                >
                  <span class="grid size-[52px] shrink-0 place-items-center rounded-[10px] border">
                    <i
                      class={`ph ph-${item.icon} text-[32px] leading-none`}
                      aria-hidden="true"
                    />
                  </span>
                  <span class="min-w-0 text-base leading-6">
                    <span class="block truncate font-semibold">
                      {item.label}
                    </span>
                    <span class="text-muted-foreground block truncate">
                      {item.description}
                    </span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <a
          href={feature.href}
          class="bg-subtle group/feature relative block min-w-0 overflow-hidden rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-current"
          aria-label={`${feature.eyebrow}: ${feature.title}`}
        >
          <img
            src={feature.asset}
            alt={feature.alt}
            class:list={[
              "navigation-feature-media absolute max-w-none",
              feature.variant === "story" &&
                "navigation-feature-media--story inset-0 size-full object-cover",
              feature.variant === "product" &&
                "navigation-feature-media--product top-[100px] left-6 h-[720px] w-[1080px] rounded-[15px] object-cover object-left-top shadow-[0_16px_32px_rgba(186,193,122,0.2)]",
              feature.variant === "guide" &&
                "navigation-feature-media--guide top-[100px] left-[-174px] h-[220px] w-[774px]",
            ]}
          />

          {
            feature.variant === "story" && (
              <div class="absolute inset-0 bg-linear-to-b from-[rgba(0,0,0,0.72)] via-[rgba(0,0,0,0.05)] to-[rgba(0,0,0,0.35)]" />
            )
          }
          {
            feature.variant !== "story" && (
              <span class="navigation-feature-halo" aria-hidden="true" />
            )
          }

          <span
            class:list={[
              "absolute top-5 right-5 left-5 z-10 flex flex-col items-start gap-1 [word-break:break-word]",
              { "text-[#fff]": feature.variant === "story" },
            ]}
          >
            <span
              class:list={[
                "text-sm leading-5 font-medium",
                feature.variant === "story"
                  ? "text-[#e6ff03]"
                  : "text-muted-foreground",
              ]}
            >
              {feature.eyebrow}
            </span>
            <span class="text-[20px] leading-7 font-semibold tracking-[-0.4px]">
              {feature.title}
            </span>
          </span>
        </a>
      </div>
    </div>
  </details>
</header-menu>

<script>
  import { customElementDefine } from "../lib/dom";

  class HeaderMenu extends HTMLElement {
    details: HTMLDetailsElement | null = null;

    connectedCallback() {
      this.details = this.querySelector("details");
      this.details?.addEventListener("toggle", this.onToggle);
      document.addEventListener("click", this.onDocumentClick);
      document.addEventListener("keydown", this.onKeyDown);
    }

    disconnectedCallback() {
      this.details?.removeEventListener("toggle", this.onToggle);
      document.removeEventListener("click", this.onDocumentClick);
      document.removeEventListener("keydown", this.onKeyDown);
    }

    onToggle = () => {
      if (!this.details?.open) return;

      document
        .querySelectorAll<HTMLDetailsElement>("header-menu details[open]")
        .forEach((menu) => {
          if (menu !== this.details) menu.open = false;
        });
    };

    onDocumentClick = (event: MouseEvent) => {
      if (!this.contains(event.target as Node) && this.details) {
        this.details.open = false;
      }
    };

    onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && this.details?.open) {
        this.details.open = false;
        this.details.querySelector("summary")?.focus();
      }
    };
  }

  customElementDefine("header-menu", () => HeaderMenu);
</script>

<style>
  .navigation-feature-halo {
    position: absolute;
    bottom: -52px;
    left: 50%;
    z-index: 2;
    display: block;
    width: 783px;
    height: 783px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .navigation-feature-halo::before {
    position: absolute;
    inset: -21.93%;
    content: "";
    background: url("/navigation/ellipse.svg") center / 100% 100% no-repeat;
    transform: rotate(180deg) scaleY(-1);
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .navigation-feature-media {
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    a:hover .navigation-feature-media--product {
      transform: translate3d(0, -4px, 0);
    }

    a:hover .navigation-feature-media--guide {
      transform: translate3d(-8px, 0, 0);
    }

    a:hover .navigation-feature-media--story {
      transform: scale(1.02);
    }
  }
</style>
